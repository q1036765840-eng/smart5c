  if (null != reviewResultVO) {\n                            String imageInfo = null;\n                            if(CharSequenceUtil.isNotBlank(reviewResultVO.getImagePath())){\n                                imageInfo = imagePath;\n                                if(CharSequenceUtil.isNotBlank(reviewResultVO.getMarkedRegions()) && !\"[]\".equals(reviewResultVO.getMarkedRegions())){\n                                    imageInfo += \";\"+reviewResultVO.getMarkedRegions();\n                                }\n                            }\n                            log.info(\"exportInspectionData_imageInfo:{}\",imageInfo);\n                            List<Object> data = Lists.newArrayList(result.getInspectionTime(), result.getSectionName(), result.getLineName(), result.getStationName(), result.getPillarNo(), result.getKmSign(), result.getAnalyzer(), result.getLocomotiveNumber(), LogicStatusEnum.getNameByCode(result.getImageValid()), PantographStatusEnum.getNameByCode(result.getPantographStatus()),reviewResultVO.getProblemDesc(),imageInfo);\n                            baseDataList.add(data);\n                        }else{\n                            List<Object> data = Lists.newArrayList(result.getInspectionTime(), result.getSectionName(), result.getLineName(), result.getStationName(), result.getPillarNo(), result.getKmSign(), result.getAnalyzer(), result.getLocomotiveNumber(), LogicStatusEnum.getNameByCode(result.getImageValid()), PantographStatusEnum.getNameByCode(result.getPantographStatus()),null,imagePath);\n                            baseDataList.add(data);\n                        }\n                    }\n                }\n            }\n        }\n        excelProcessUtil.exportWithPicturesAsZip(title, baseDataList, \"inspectDataReport.zip\", response);\n    }\n}
