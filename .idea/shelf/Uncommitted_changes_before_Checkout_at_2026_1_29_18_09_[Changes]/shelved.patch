n    com.baomidou.mybatisplus: info # MyBatis-Plus日志级别jwt:\n\nupload:\n  product:\n    images: /usr/local/temp/images\njwt:\n  tokenHeader: Authorization #JWT存储的请求头\n  secret: police-admin-secret #JWT加解密使用的密钥\n  expiration: 604800 #JWT的超期限时间(60*60*24)\n  tokenHead: Bearer  #JWT负载中拿到开头\nfile:\n  access:\n    url: http://172.16.4.4:9001/file/\n    public-url: http://117.175.160.250:9001/file/\n  save:\n    path: /usr/local/policeAi/\nswitch:\n  turn:\n    url: http://172.16.4.2:8999/power/control,http://172.16.4.3:8999/power/control #灯光控制\nuser:\n  sync:\n    url: http://172.16.4.2:5000/police/people,http://172.16.4.3:5000/police/people\nimage:\n  search:\n    url: http://172.16.4.2:8999/image/search,http://172.16.4.3:8999/image/search #陌生人搜索\n  person:\n    search: http://172.16.4.2:8999/image/person/search #会议室签到人员搜索,功能停用\nminio:\n  endpoint: http://172.16.4.4:9009 # 注意这里一定要加“http://”，否则可能出错\n  accessKey: admin\n  secretKey: dzga#2025\n  bucket: public\n  public-url: http://117.175.160.250:9009\ntemplates:\n  path: http://172.16.4.4:9009/public/policeAi/templates/ #用户信息导入模板\npolice:\n  floor:\n    design: http://172.16.4.4:9009/public/policeAi/police_floor_design.jpg\n    public-url: http://117.175.160:9009/public/policeAi/police_floor_design.jpg\nipc:\n  sync:\n    api: http://172.16.4.2:8999/cameras,http://172.16.4.3:8999/cameras,  #摄像头同步\n    zoneApi: http://172.16.4.2:8909/zones,http://172.16.4.3:8909/zones  #防区同步\n    strategies: http://172.16.4.2:8909/strategies/update,http://172.16.4.3:8909/strategies/update   #策略同步\n#mqtt配置\nmqtt:\n  url: tcp://127.0.0.1:1883\n  host: 127.0.0.1:18083\n  username: admin\n  password: admin\n  #  api-key: xxx\n  #  secret-key: xxx\n  clientId: java-mqtt-client\n  default-topic: police/topic\n  cleanSession: true\n  connection-timeout: 3000\n  subscription-topic:\n    - dev/redkey/monitor\n    - $SYS/brokers/+/clients/+/connected\n    - $SYS/brokers/+/clients/+/disconnected
