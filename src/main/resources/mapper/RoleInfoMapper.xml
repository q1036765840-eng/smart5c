<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nbk.smart5c.mapper.RoleInfoMapper">

    <sql id="fields">
        `roleInfo`.`id` AS `id`,
        `roleInfo`.`role_code` AS `roleCode`,
        `roleInfo`.`role_name` AS `roleName`,
        `roleInfo`.`created_user` AS `createdUser`,
        `roleInfo`.`created_time` AS `createdTime`,
        `roleInfo`.`updated_user` AS `updatedUser`,
        `roleInfo`.`updated_time` AS `updatedTime`
    </sql>

    <sql id="where">
        <if test="query.id != null and query.id != ''">
            AND `roleInfo`.`id` = #{query.id}
        </if>
        <if test="query.roleCode != null and query.roleCode != ''">
            AND `roleInfo`.`role_code` LIKE CONCAT('%',#{query.roleCode},'%')
        </if>
        <if test="query.roleName != null and query.roleName != ''">
            AND `roleInfo`.`role_name` LIKE CONCAT('%',#{query.roleName},'%')
        </if>
        <if test="query.createdUser != null and query.createdUser != ''">
            AND `roleInfo`.`created_user` LIKE CONCAT('%',#{query.createdUser},'%')
        </if>
        <if test="query.updatedUser != null and query.updatedUser != ''">
            AND `roleInfo`.`updated_user` LIKE CONCAT('%',#{query.updatedUser},'%')
        </if>
    </sql>

    <select id="queryAndPaging" resultType="com.nbk.smart5c.pojo.vo.RoleInfoVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_role_info` AS `roleInfo`
        <where>
            <include refid="where"/>
        </where>
    </select>

    <select id="queryAll" resultType="com.nbk.smart5c.pojo.vo.RoleInfoVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_role_info` AS `roleInfo`
        <where>
            <include refid="where"/>
        </where>
    </select>

</mapper>
