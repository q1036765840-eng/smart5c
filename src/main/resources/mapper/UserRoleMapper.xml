<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nbk.smart5c.mapper.UserRoleMapper">

    <sql id="fields">
        `userRole`.`id` AS `id`,
        `userRole`.`user_id` AS `userId`,
        `userRole`.`role_id` AS `roleId`,
        `userRole`.`created_user` AS `createdUser`,
        `userRole`.`created_time` AS `createdTime`,
        `userRole`.`updated_user` AS `updatedUser`,
        `userRole`.`updated_time` AS `updatedTime`
    </sql>

    <sql id="where">
        <if test="query.id != null and query.id != ''">
            AND `userRole`.`id` = #{query.id}
        </if>
        <if test="query.userId != null and query.userId != ''">
            AND `userRole`.`user_id` = #{query.userId}
        </if>
        <if test="query.roleId != null and query.roleId != ''">
            AND `userRole`.`role_id` = #{query.roleId}
        </if>
        <if test="query.createdUser != null and query.createdUser != ''">
            AND `userRole`.`created_user` LIKE CONCAT('%',#{query.createdUser},'%')
        </if>
        <if test="query.updatedUser != null and query.updatedUser != ''">
            AND `userRole`.`updated_user` LIKE CONCAT('%',#{query.updatedUser},'%')
        </if>
    </sql>

    <select id="queryAndPaging" resultType="com.nbk.smart5c.pojo.vo.UserRoleVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_user_role` AS `userRole`
        <where>
            <include refid="where"/>
        </where>
    </select>

    <select id="queryAll" resultType="com.nbk.smart5c.pojo.vo.UserRoleVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_user_role` AS `userRole`
        <where>
            <include refid="where"/>
        </where>
    </select>

</mapper>
