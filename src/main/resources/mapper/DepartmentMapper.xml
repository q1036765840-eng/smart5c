<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nbk.smart5c.mapper.DepartmentMapper">

    <sql id="fields">
        `department`.`id` AS `id`,
        `department`.`department_code` AS `departmentCode`,
        `department`.`department_name` AS `departmentName`,
        `department`.`parent_id` AS `parentId`,
        `department`.`remark` AS `remark`,
        `department`.`created_user` AS `createdUser`,
        `department`.`created_time` AS `createdTime`,
        `department`.`updated_user` AS `updatedUser`,
        `department`.`updated_time` AS `updatedTime`,
        `department`.`ancestors` AS `ancestors`,
        `department`.`path` AS `path`
    </sql>

    <sql id="where">
        <if test="query.id != null and query.id != ''">
            AND `department`.`id` = #{query.id}
        </if>
        <if test="query.departmentCode != null and query.departmentCode != ''">
            AND `department`.`department_code` LIKE CONCAT('%',#{query.departmentCode},'%')
        </if>
        <if test="query.departmentName != null and query.departmentName != ''">
            AND `department`.`department_name` LIKE CONCAT('%',#{query.departmentName},'%')
        </if>
        <if test="query.parentId != null and query.parentId != ''">
            AND `department`.`parent_id` = #{query.parentId}
        </if>
        <if test="query.remark != null and query.remark != ''">
            AND `department`.`remark` LIKE CONCAT('%',#{query.remark},'%')
        </if>
        <if test="query.createdUser != null and query.createdUser != ''">
            AND `department`.`created_user` LIKE CONCAT('%',#{query.createdUser},'%')
        </if>
        <if test="query.updatedUser != null and query.updatedUser != ''">
            AND `department`.`updated_user` LIKE CONCAT('%',#{query.updatedUser},'%')
        </if>
        <if test="query.ancestors != null and query.ancestors != ''">
            AND `department`.`ancestors` LIKE CONCAT('%',#{query.ancestors},'%')
        </if>
        <if test="query.path != null and query.path != ''">
            AND `department`.`path` LIKE CONCAT('%',#{query.path},'%')
        </if>
    </sql>

    <select id="queryAndPaging" resultType="com.nbk.smart5c.pojo.vo.DepartmentVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_department` AS `department`
        <where>
            <include refid="where"/>
        </where>
    </select>

    <select id="queryAll" resultType="com.nbk.smart5c.pojo.vo.DepartmentVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_department` AS `department`
        <where>
            <include refid="where"/>
        </where>
    </select>

</mapper>
