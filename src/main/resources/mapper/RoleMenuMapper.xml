<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nbk.smart5c.mapper.RoleMenuMapper">

    <sql id="fields">
        `roleMenu`.`role_id` AS `roleId`,
        `roleMenu`.`menu_id` AS `menuId`
    </sql>

    <sql id="where">
        <if test="query.roleId != null and query.roleId != ''">
            AND `roleMenu`.`role_id` = #{query.roleId}
        </if>
        <if test="query.menuId != null and query.menuId != ''">
            AND `roleMenu`.`menu_id` = #{query.menuId}
        </if>
    </sql>

    <select id="queryAndPaging" resultType="com.nbk.smart5c.pojo.vo.RoleMenuVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_role_menu` AS `roleMenu`
        <where>
            <include refid="where"/>
        </where>
    </select>

    <select id="queryAll" resultType="com.nbk.smart5c.pojo.vo.RoleMenuVO">
        SELECT
        <include refid="fields"/>
        FROM `nbk_role_menu` AS `roleMenu`
        <where>
            <include refid="where"/>
        </where>
    </select>

</mapper>
