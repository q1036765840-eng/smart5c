    <distributionManagement>
        <repository>
            <id>nbkmaven</id>
            <url>http://192.168.0.229/maven</url>
        </repository>
        <!--<repository>
            <id>nexus-aliyun</id>
            <name>Nexus aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
